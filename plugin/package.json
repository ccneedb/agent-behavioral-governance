{
  "name": "dsh-agent-behavioral-governance",
  "version": "0.2.0",
  "private": true,
  "description": "Agent Behavioral Governance (ABG): an additive project-work governance layer for DeepSeek Harness. Contributes one system-prompt section and uses deterministic runtime seams (agent/pre-step, tools/pre-execute, tools.guard) for enforcement. Zero runtime dependencies.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "governance",
    "agent-behavior"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "verified"
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json"
  }
}
