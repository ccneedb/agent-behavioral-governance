{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["lib", "src"],
  "exclude": [
    // `lib/generated/**` is the `tsc` build output of `src/**/*.ts`
    // (`tsconfig.build.json`). It is excluded here because emitted JavaScript
    // must not re-enter the `checkJs` program; its `.d.ts` siblings are still
    // resolved as dependencies of `lib/**/*.js`. Rebuild with
    // `npm run build` after editing `src/` — see TYPESCRIPT-MIGRATION.md.
    "lib/generated"
  ]
}
