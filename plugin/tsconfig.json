{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["lib"],
  // The Web GUI bundle is a hand-authored browser artifact (lazy-CJS envelope,
  // baseline `require`, browser globals), not Node source; it is not typechecked.
  "exclude": ["lib/client.js"]
}
