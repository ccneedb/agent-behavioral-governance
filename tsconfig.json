{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  // The program is the TypeScript source. `lib/**` is the `tsc` build output of
  // `src/**/*.ts` (`tsconfig.build.json`), so it is deliberately not part of the
  // check: emitted JavaScript must never re-enter the program. The one
  // hand-authored declaration file, the ambient seam contract, is included.
  // `exclude` is deliberately absent: naming a file in `include` does not
  // protect it from an overlapping `exclude`, and excluding `lib` would drop
  // the ambient contract below.
  "include": ["src", "lib/contract.d.ts"]
}
